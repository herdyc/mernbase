# Copy to .env and fill in. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017/study-planner
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# The address of the React client, for CORS in production
CLIENT_ORIGIN=http://localhost:5173
